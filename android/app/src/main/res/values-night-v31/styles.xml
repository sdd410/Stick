<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Shown while the process starts. Dark so the launch never flashes white. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowSplashScreenBackground">@color/stick_background</item>
    </style>
    <!-- Window colour behind the Flutter UI. -->
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@color/stick_background</item>
        <item name="android:windowSplashScreenBackground">@color/stick_background</item>
    </style>
</resources>
