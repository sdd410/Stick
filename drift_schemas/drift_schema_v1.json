  "fixed_sql": [
    {
      "name": "habits",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"habits\" (\"id\" INTEGER NOT NULL, \"name\" TEXT NOT NULL, \"tiny\" TEXT NULL, \"why\" TEXT NOT NULL, \"reminder_minutes\" INTEGER NOT NULL, \"created_at\" INTEGER NOT NULL, \"emoji\" TEXT NOT NULL DEFAULT '⭐', \"template_id\" TEXT NULL, \"quiz_quit_day\" TEXT NULL, \"quiz_reason\" TEXT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "attempts",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"attempts\" (\"number\" INTEGER NOT NULL, \"start_day\" TEXT NOT NULL, \"quit_target\" INTEGER NOT NULL, \"first_miss_day\" INTEGER NULL, \"resumed_day\" TEXT NULL, \"final_day\" INTEGER NULL, \"ended_day\" TEXT NULL, PRIMARY KEY (\"number\"));"
        }
      ]
    },
    {
      "name": "check_ins",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"check_ins\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"day\" TEXT NOT NULL, \"attempt\" INTEGER NOT NULL, \"tiny\" INTEGER NOT NULL CHECK (\"tiny\" IN (0, 1)), UNIQUE (\"day\", \"attempt\"));"
        }
      ]
    },
    {
      "name": "clips",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"clips\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"type\" TEXT NOT NULL, \"path\" TEXT NOT NULL, \"attempt\" INTEGER NOT NULL, \"recorded_at\" INTEGER NOT NULL, \"day_number\" INTEGER NOT NULL, \"duration_ms\" INTEGER NOT NULL);"
        }
      ]
    },
    {
      "name": "flags",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"flags\" (\"id\" INTEGER NOT NULL, \"day4_celebrated\" INTEGER NOT NULL DEFAULT 0 CHECK (\"day4_celebrated\" IN (0, 1)), \"last_weekly_replay_day_number\" INTEGER NULL, \"home_style\" TEXT NOT NULL DEFAULT 'bigNumber', \"check_in_mode\" TEXT NOT NULL DEFAULT 'slide', \"tips_seen\" INTEGER NOT NULL DEFAULT 0 CHECK (\"tips_seen\" IN (0, 1)), PRIMARY KEY (\"id\"));"
        }
      ]
    }
  ]
